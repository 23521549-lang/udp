{
  "name": "@udp/openfeature-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenFeature provider cho SERVER key của UDP: đánh giá tại chỗ, đồng bộ SSE, nhãn ff cho auto-rollback mức flag",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./metrics": "./src/metrics.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./metrics": {
        "types": "./dist/types/metrics.d.ts",
        "default": "./dist/metrics.js"
      }
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "prom-client": "^15.1.3"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "@udp/config": "workspace:*",
    "@udp/db": "workspace:*",
    "@udp/flag-evaluator": "workspace:*",
    "@udp/metrics-provider": "workspace:*",
    "@udp/shared-types": "workspace:*",
    "@udp/test-support": "workspace:*",
    "esbuild": "0.28.2",
    "express": "^4.21.2",
    "fast-check": "^3.23.2",
    "prom-client": "^15.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
