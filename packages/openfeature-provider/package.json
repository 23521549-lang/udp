{
  "name": "@udp/openfeature-provider",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenFeature provider for UDP server keys: in-process evaluation, SSE sync, and per-request ff labels for flag-level auto-rollback",
  "keywords": [
    "openfeature",
    "openfeature-provider",
    "feature-flags",
    "feature-toggles",
    "progressive-delivery",
    "canary",
    "prometheus",
    "opentelemetry"
  ],
  "license": "Apache-2.0",
  "author": "UDP (https://github.com/23521549-lang/udp)",
  "homepage": "https://github.com/23521549-lang/udp/tree/main/packages/openfeature-provider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/23521549-lang/udp.git",
    "directory": "packages/openfeature-provider"
  },
  "bugs": {
    "url": "https://github.com/23521549-lang/udp/issues"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./metrics": "./src/metrics.ts",
    "./testing": "./src/testing.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "name": "udp-openfeature",
    "main": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./metrics": {
        "types": "./dist/types/metrics.d.ts",
        "default": "./dist/metrics.js"
      }
    }
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "prom-client": "^15.1.3"
  },
  "peerDependenciesMeta": {
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openfeature/core": "^1.12.0",
    "@openfeature/server-sdk": "^1.23.0",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "@udp/config": "workspace:*",
    "@udp/db": "workspace:*",
    "@udp/flag-evaluator": "workspace:*",
    "@udp/metrics-provider": "workspace:*",
    "@udp/shared-types": "workspace:*",
    "@udp/test-support": "workspace:*",
    "esbuild": "0.28.2",
    "express": "^4.21.2",
    "fast-check": "^3.23.2",
    "prom-client": "^15.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
