{
  "name": "@udp/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "//": "Không script nào tự nạp .env: prisma.config.ts nạp cho đường CLI, @udp/config/env nạp cho đường seed. Một việc, một nơi làm",
