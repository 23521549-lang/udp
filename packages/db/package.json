    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "prisma": "^7.10.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
