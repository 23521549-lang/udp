# Cấu hình của máy ảo UDP (Plan #52 QĐ-4). bootstrap.sh chép tệp này thành ~/udp/vm.env (quyền 0600); điền rồi
# chạy workflow Deploy. Tệp đã điền KHÔNG BAO GIỜ vào repo. Đọc bằng schema của deploy/src/vm.ts — sai là dừng
# trước khi chạm cụm.

# Tên miền trỏ về IP công khai của máy ảo, chữ thường, không https:// (DuckDNS: <tên>.duckdns.org)
UDP_PUBLIC_HOST=

# Email Let's Encrypt gửi cảnh báo hết hạn chứng chỉ
ACME_EMAIL=

# letsencrypt | letsencrypt-staging (thử cấu hình, chứng chỉ trình duyệt không tin) | self-signed (chỉ lượt CI)
TLS_ISSUER=letsencrypt

# URL của Pre-Authenticated Request CHỈ-GHI trên bucket sao lưu (Object Storage), kết thúc bằng /o/
UDP_BACKUP_UPLOAD_URL=

# CHỈ khi dựng lại trên máy MỚI từ bản sao lưu, và đặt TRƯỚC lần phát hành đầu: KEK cũ (bắt buộc để credential
# BYOC trong bản dump giải được) và khoá ký OIDC cũ (tuỳ chọn — giữ nguyên JWKS cho federation của khách).
# UDP_KEK_V1=
# UDP_OIDC_SIGNING_KEY=
