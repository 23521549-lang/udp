# Ứng dụng khách mẫu của UDP (apps/sample-app) — chép thành .env
# Service 2 (flag-service) và SERVER key của env (seed dev in khoá ra lúc seed)
UDP_FLAG_HOST=http://127.0.0.1:3002
UDP_SDK_KEY=udp_sk_dev_0000000000000000000000000000
PORT=3010
# PHẢI bằng workloadName của rollout; job Prometheus `sample-app` gắn namespace
OTEL_SERVICE_NAME=sample-app
# service_version của metric (canary SERVICE_LEVEL phân biệt version bằng nhãn này)
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0
# /chaos/* chỉ bật khi đo (E5, E6) — KHÔNG bao giờ bật ở ứng dụng thật
CHAOS_ENABLED=false
CHECKOUT_FLAG_KEY=checkout-v2
# Nhóm user dò để đo MTTR (T3 của E5) — lớn đủ để còn ≥ 20 user ở nhánh canary
PROBE_USERS=200
