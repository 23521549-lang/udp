{
  "name": "udp",
  "version": "0.1.0",
  "private": true,
  "description": "UDP — Configurable DevOps Platform with Integrated Feature Flags and Progressive Delivery",
  "//engines": "20.11 chứ không phải 20: packages/db/prisma.config.ts dùng import.meta.dirname, có từ Node 20.11. Khai >=20 là hứa sai — Node 20.9 trả undefined rồi lỗi ở một chỗ khác hẳn",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "db:generate": "pnpm --filter @udp/db generate",
    "db:migrate": "pnpm --filter @udp/db migrate",
    "db:studio": "pnpm --filter @udp/db studio",
    "db:seed": "pnpm --filter @udp/db seed",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:core": "pnpm --filter @udp/core-backend dev",
    "dev:flags": "pnpm --filter @udp/flag-service dev",
    "dev:pd": "pnpm --filter @udp/pd-controller dev",
    "dev:portal": "pnpm --filter @udp/portal dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "//test": "test chạy trên database dev đang dùng (nhanh, cho vòng lặp phát triển). test:scratch dựng database dùng-một-lần từ chuỗi migration, seed, chạy đủ mọi package rồi xoá — đúng lệnh CI chạy, cần chuỗi thật của ba role trong .env",
    "test": "pnpm -r --if-present test",
    "test:scratch": "pnpm --filter @udp/db test:scratch",
    "db:service-login": "pnpm --filter @udp/db service-login",
    "db:verify-chain": "pnpm --filter @udp/db verify-chain",
    "db:ci-bootstrap": "pnpm --filter @udp/db ci-bootstrap"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  }
}
