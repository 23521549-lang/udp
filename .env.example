# ============================================================
# UDP — biến môi trường (bản mẫu, ĐƯỢC commit)
#
# Nguồn sự thật về DANH SÁCH biến và quy tắc hợp lệ là
# packages/config/src/env.ts (Zod schema). File này chỉ là bản chép ra
# cho người đọc — khi thêm biến, sửa schema TRƯỚC rồi mới chép sang đây.
#
# Copy sang .env rồi thay giá trị thật. .env KHÔNG được commit.
# ============================================================

# ---------- PostgreSQL (docker-compose đọc trực tiếp các biến này) ----------
POSTGRES_USER=udp
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=udp
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090

# Đổi mật khẩu thì phải sửa CẢ POSTGRES_PASSWORD ở trên VÀ chuỗi dưới đây.
DATABASE_URL="postgresql://udp:doi-mat-khau-nay@localhost:5432/udp?schema=public"
# Kết nối direct (session mode) cho migration, pg-boss và NOTIFY — xem §15.3.
# Bỏ trống ở dev; khi triển khai sau pooler thì trỏ vào cổng session mode.
# DATABASE_URL_DIRECT=""

# ---------- Runtime ----------
NODE_ENV="development"
LOG_LEVEL="debug"

# ---------- Auth ----------
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"
JWT_REFRESH_SECRET="thay-bang-chuoi-ngau-nhien-khac-toi-thieu-32-ky-tu"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
BCRYPT_ROUNDS=12

# ---------- Envelope encryption cho Cloud Credential (§4.3) ----------
# KEK 32 byte base64. Môi trường thật lấy từ KMS; lab lấy từ đây.
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Đổi KEK thì TĂNG version và giữ key cũ để unwrap DEK đã lưu.
UDP_KEK_VERSION=1
UDP_KEK_V1="thay-bang-chuoi-base64-32-byte"

# ---------- Bí mật nội bộ giữa 3 service ----------
INTERNAL_SERVICE_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"

# ---------- Ports ----------
CORE_BACKEND_PORT=3001
FLAG_SERVICE_PORT=3002
PD_CONTROLLER_PORT=3003
PORTAL_PORT=5173

# ---------- URL nội bộ ----------
FLAG_SERVICE_URL="http://localhost:3002"
CORE_BACKEND_URL="http://localhost:3001"
PROMETHEUS_URL="http://localhost:9090"

# ---------- CORS / Cookie ----------
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# ---------- Progressive Delivery Controller ----------
RECONCILE_INTERVAL_MS=30000

# ---------- Change feed (ADR-05) ----------
# snapshot = chỉ tầng 1 | delta = bật thêm tầng 2 (con trỏ xid8)
CHANGEFEED_MODE="snapshot"
CHANGEFEED_NOTIFY_ENABLED=true

# ---------- Job queue (ADR-02, điều kiện 2) ----------
# PHẢI lớn hơn thời gian provisioning tối đa. EKS mất 15–20 phút; đặt ngắn hơn
# thì pg-boss giao lại job ĐANG CHẠY cho worker khác ⇒ tạo cluster thứ hai.
JOB_EXPIRE_MINUTES=45
JOB_RETRY_LIMIT=3
PGBOSS_SCHEMA="pgboss"

# ---------- Cloud MANAGED mode (để trống khi chỉ dùng BYOC) ----------
MANAGED_AWS_ACCESS_KEY_ID=""
MANAGED_AWS_SECRET_ACCESS_KEY=""
MANAGED_AWS_REGION="ap-southeast-1"
MANAGED_GCP_SERVICE_ACCOUNT_JSON=""
MANAGED_GCP_PROJECT_ID=""
MANAGED_AZURE_TENANT_ID=""
MANAGED_AZURE_CLIENT_ID=""
MANAGED_AZURE_CLIENT_SECRET=""
MANAGED_AZURE_SUBSCRIPTION_ID=""
